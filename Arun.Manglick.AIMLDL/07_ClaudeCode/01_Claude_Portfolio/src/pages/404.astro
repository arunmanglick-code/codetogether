---
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout title="Page Not Found">
  <div class="text-center py-20">
    <p class="text-8xl font-bold text-primary-500 mb-6">404</p>
    <h1 class="text-3xl font-bold mb-4">Page Not Found</h1>
    <p class="text-slate-600 dark:text-slate-400 mb-8 max-w-md mx-auto">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 bg-primary-500 text-white px-6 py-3 rounded-lg hover:bg-primary-600 transition-colors font-medium"
    >
      Go Home
      <span>&rarr;</span>
    </a>
  </div>
</PageLayout>
