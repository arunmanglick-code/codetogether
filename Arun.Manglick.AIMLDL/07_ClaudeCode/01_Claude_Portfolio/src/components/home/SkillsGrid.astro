---
import skillsData from '../../data/skills.json';
---

<section class="py-16">
  <h2 class="text-3xl font-bold mb-8">Skills & Technologies</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {skillsData.domains.map((domain) => (
      <div class="bg-[var(--color-bg-secondary)] rounded-lg p-6 border border-[var(--color-border)]">
        <h3 class="text-lg font-semibold mb-3">{domain.name}</h3>
        <div class="flex flex-wrap gap-2">
          {domain.skills.map((skill) => (
            <span class="bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm px-3 py-1 rounded-full">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
